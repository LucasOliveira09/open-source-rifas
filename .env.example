# Copie este arquivo para .env e configure a integração Checkout Transparente / Orders.
# Access Token APP_USR: da conta vendedora para produção ou de um usuário de teste
# para sandbox. Credenciais antigas TEST- não são compatíveis com a Orders API.
MERCADO_PAGO_ACCESS_TOKEN=
# Segredo de assinatura gerado no painel Webhooks da mesma integração (evento Order).
MERCADO_PAGO_WEBHOOK_SECRET=

# Expiração do Pix: duração ISO 8601; padrão de 24 horas
PIX_EXPIRATION=PT24H

# E-mail fictício por compra: rifa-<identificador>@<domínio>.
# Em sandbox do Mercado Pago, use testuser.com.
PIX_BUYER_EMAIL_DOMAIN=example.com

# Banco local de desenvolvimento
POSTGRES_PASSWORD=rifas_local_dev
