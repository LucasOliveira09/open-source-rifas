# Copie este arquivo para .env e configure Checkout Transparente / Payments API.
# Use o Access Token das credenciais da aplicação no ambiente escolhido.
# Para cobranças reais, use a credencial de produção da conta vendedora.
MERCADO_PAGO_ACCESS_TOKEN=
# Assinatura secreta gerada no painel Webhooks da mesma aplicação (evento Pagamentos).
MERCADO_PAGO_WEBHOOK_SECRET=
# Opcional: URL pública HTTPS terminando em /api/webhooks/mercadopago.
# Se vazia, configure a URL no painel Webhooks, selecionando Pagamentos.
MERCADO_PAGO_NOTIFICATION_URL=

# Expiração do Pix: duração ISO 8601; padrão de 24 horas
PIX_EXPIRATION=PT24H

# E-mail fictício utilizado nas compras Pix.
# Em sandbox do Mercado Pago, use um endereço com domínio @testuser.com.
PIX_BUYER_EMAIL=rifas@example.com

# Banco local de desenvolvimento
POSTGRES_PASSWORD=rifas_local_dev
